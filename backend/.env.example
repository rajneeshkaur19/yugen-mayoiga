DATABASE_URL=postgresql+psycopg://yugen_user:your_password@localhost:5432/yugen_mayoiga
JWT_SECRET_KEY=your_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Configuration & Multi-Provider Fallback
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=gemini,openai,ollama

# Primary: Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Secondary Fallback: OpenAI (optional)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Tertiary Fallback: Local Ollama (optional)
# OLLAMA_MODEL=phi3:latest
# OLLAMA_API_BASE=http://127.0.0.1:11434
# OLLAMA_TIMEOUT=90.0
# OLLAMA_NUM_PREDICT=384
